{
  "name": "cohortglobal",
  "version": "0.1.0",
  "private": true,
  "description": "CohortGlobal \u2014 CohortData's data-collection platform for agencies, vendors and freelancers.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:local": "bash scripts/db/test-local.sh",
    "db:types": "supabase gen types typescript --local > src/server/db/database.types.ts",
    "bootstrap:super-admin": "node --env-file=.env.local scripts/bootstrap-super-admin.mjs",
    "speed:check": "node --env-file=.env.local scripts/speed-check.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.0",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.12.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.4",
    "next-intl": "^4.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.4",
    "supabase": "^2.30.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
