# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (authentication only) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Secrets: leave empty here, put real values only in .env.local and in the host's settings (marked secret).
CLERK_SECRET_KEY=
# From Clerk → Webhooks → your endpoint → Signing secret (starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — `pnpm db:start` prints local values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=              # server only, never NEXT_PUBLIC_; a secret

# Email (optional in development: without it, emails are printed to the server log)
RESEND_API_KEY=
EMAIL_FROM="CohortGlobal <no-reply@your-domain.com>"

# Storage bucket for agency documents (ID-12)
AGENCY_DOCUMENTS_BUCKET=agency-documents

# Where Clerk sends people after sign-in / sign-up (the app then routes by role)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Only for `supabase start` (AD-1 Clerk third-party auth), e.g. your-app.clerk.accounts.dev
CLERK_FRONTEND_API_DOMAIN=

# Content-Security-Policy (S8, ID-51). Empty = report-only (browser console shows what would be blocked).
# Set to 1 to enforce once the console is clean on the main screens.
CSP_ENFORCE=

# Largest file the storage service accepts, in MB (Supabase Free: 50). The collection
# builder warns when a project allows bigger files. Raise it after upgrading the plan.
STORAGE_FILE_LIMIT_MB=50
